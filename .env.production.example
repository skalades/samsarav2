# ==============================================================================
# SAMSARA - Production Environment Configuration Template
# Salin file ini menjadi .env di server produksi dan sesuaikan kredensial rahasia.
# ==============================================================================

APP_NAME="SAMSARA EXPEDITION"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://samsaracikuray.id
SEO_CANONICAL_URL=https://samsaracikuray.id
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# Quick Login (Wajib FALSE di environment produksi)
ALLOW_QUICK_LOGIN=false

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_DAILY_DAYS=30

# ==============================================================================
# Database Configuration (PostgreSQL / MySQL)
# ==============================================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=samsara_production
DB_USERNAME=samsara_user
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_KUAT

# ==============================================================================
# Session Configuration (Redis In-Memory)
# ==============================================================================
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ==============================================================================
# Cache & Queue Configuration (Redis Dedicated DB Isolation)
# ==============================================================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Driver Redis: Gunakan 'predis' (universal PHP fallback) atau 'phpredis' (C-extension berkecepatan tinggi)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=GANTI_DENGAN_PASSWORD_REDIS_KUAT
REDIS_PORT=6379

# Redis Database Index Isolation:
# DB 0: Default framework / general
# DB 1: Cache (dapat di-flush kapan saja tanpa mengganggu session / antrean)
# DB 2: Session (auth login user & admin)
# DB 3: Queue (antrean job email, tiket simaksi, invoice)
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_QUEUE_CONNECTION=queue

# ==============================================================================
# Mail Configuration (SMTP / Mailgun / SES)
# ==============================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@samsaracikuray.id
MAIL_PASSWORD=GANTI_DENGAN_PASSWORD_SMTP
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@samsaracikuray.id"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp Gateway (log | fonnte | wablas | webhook)
WA_GATEWAY_DRIVER=log
WA_GATEWAY_ENDPOINT=
WA_GATEWAY_TOKEN=
WA_GATEWAY_SECRET=
WA_AUTO_SEND_ON_PAID=true
WA_GATEWAY_TIMEOUT=10

# ==============================================================================
# Reverse proxy (Cloudflare / load balancer). Kosongkan bila Nginx langsung publik.
# Isi daftar IP/CIDR dipisah koma, atau "*" bila server hanya bisa diakses lewat proxy.
# ==============================================================================
TRUSTED_PROXIES=

# ==============================================================================
# Akun Superadmin awal (php artisan db:seed --class=SuperAdminSeeder --force)
# Kosongkan SUPERADMIN_PASSWORD agar dibuat acak & ditampilkan sekali.
# HAPUS nilai password dari .env setelah akun dibuat.
# ==============================================================================
SUPERADMIN_EMAIL=admin@samsaracikuray.id
SUPERADMIN_NAME="Super Admin SAMSARA"
SUPERADMIN_PASSWORD=
SUPERADMIN_PHONE=

# ==============================================================================
# Nilai awal kontak & pembayaran (opsional). Sumber utama tetap
# Pengaturan → Tarif & Profil di panel superadmin. Tidak ada nilai contoh.
# ==============================================================================
SAMSARA_ADMIN_WHATSAPP=
SAMSARA_ADMIN_WHATSAPP_DISPLAY=
SAMSARA_EMERGENCY_HOTLINE=
SAMSARA_SAR_FREQUENCY=
SAMSARA_BASECAMP_MAPS_URL=
SAMSARA_BANK_NAME=
SAMSARA_BANK_ACCOUNT=
SAMSARA_BANK_HOLDER=
SAMSARA_QRIS_NMID=
SAMSARA_QRIS_NAME=

# Deploy: token bypass maintenance (kosong → acak per deploy)
DEPLOY_BYPASS_SECRET=
